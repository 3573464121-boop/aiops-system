APP_ADDR=:8080

# ===== 数据库（可选，不配则自动用内存存储）=====
MYSQL_DSN=aiops:aiops_pass@tcp(127.0.0.1:3306)/aiops?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=127.0.0.1:6379

# 知识库文档路径（相对 backend 工作目录，或填绝对路径）
KNOWLEDGE_PATH=../README-原始需求.md

# ===== 监控告警：夜莺 Nightingale（不配则用演示告警）=====
N9E_BASE_URL=
N9E_TOKEN=

# ===== 日志平台（不配则用演示日志）=====
LOG_BASE_URL=
LOG_TOKEN=

# ===== 诊断大模型（OpenAI 兼容接口）=====
# 【推荐】DeepSeek 云端：到 https://platform.deepseek.com 申请 Key，填到 LLM_API_KEY 即启用
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 【备选】本机 Ollama（免费但慢）：改用下面三行、注释掉上面三行
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:7b

# ===== 向量检索嵌入模型（可选，本机 Ollama）=====
# 先 `ollama pull bge-m3`，再填入启用（留空=仅 BM25）
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# ===== 认证（登录令牌）=====
# AUTH_SECRET：令牌签名密钥，生产环境务必改成一段够长的随机串（留空则用内置开发密钥并告警）
AUTH_SECRET=
# AUTH_ADMIN_PASSWORD：首次启动时若库中无用户，自动创建管理员 admin 的初始口令（留空默认 admin123）
AUTH_ADMIN_PASSWORD=
